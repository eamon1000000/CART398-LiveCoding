samples('github:eamon1000000/strudelRepo')


//chip tune melody
$: arrange(
  [8, "[[1 2]!4 [3 5]!2 [4 8]!6 [2 7]!4]/4"],
  [8, "[[1 [2 [2 | 5]]]!4 [3 [3 5]]!2 [4 8]!3 [5 8]!3 [11 7]!4]/4"],
  [8, "[[1 [2 | 5]]!4 [3 5]!2 [4 8]!6 [2 7]!4]/2"]
).n().scale("c:ionian").layer(
  x=>x.s("supersaw").vib("<1 2 3 4>").chorus(4).gain(0.7).coarse("<1 16 1 16 1>").degradeBy(0.2),
  x=>x.s("z_square").gain(0.5).vib("<0.2 0 2 0 0>").degradeBy(0.3)
)

//Electric guitar gap fill
$: arrange(
  [8, "[[1 2]!4 [3 5]!2 [4 8]!6 [2 7]!4]/4"],
  [8, "[[1 [2 [2 | 5]]]!4 [3 [3 5]]!2 [4 8]!3 [5 8]!3 [11 7]!4]/4"],
  [8, "[[1 [2 | 5]]!4 [3 5]!2 [4 8]!6 [2 7]!4]/2"]
).n().scale("c:ionian").layer(
  x=>x.s("gm_electric_guitar_muted:4").chorus(4).gain(0.4).echo(2, 1/8, 0.4),
  x=>x.s("wt_digital_curses").gain(0.4)
)


//perc arrangement 
$: arrange(
  [8, "[[~ ~ ~ ~ sd:6 ~ ~ ~]!3 [~ ~ ~ ~ ~ ~ ~ ~ sd:6 ~ ~ sd:6 ~ ~ sd:6 ~]]/4 , [[~ ~ ~ ~ cp:5 ~ ~ ~]!3 [~ ~ ~ ~ ~ ~ ~ ~ cp:5 ~ ~ cp:5 ~ ~ cp:5 ~]]/4"],
  [8, "[[~ ~ ~ ~ [luxPerc, luxPerc:2] ~ ~ ~]!3 [~ ~ ~ ~ ~ ~ ~ ~ [luxPerc, luxPerc:2] ~ ~ [luxPerc:3, luxPerc:2] ~ ~ [luxPerc, luxPerc:2] ~]]/4 , [[~ ~ ~ ~ cp:2 ~ ~ ~]!3 [~ ~ ~ ~ ~ ~ ~ ~ cp:2 ~ ~ cp:2 ~ ~ cp:2 ~]]/4"]
).s().room(0.3)

$: arrange(
  [8, "~"],
  [8, "~ [luxPerc, luxPerc:2] ~ ~ ~ ~ ~ [[luxPerc, luxPerc:2] [luxPerc, luxPerc:2]]"],
  [8, "~ [luxPerc, luxPerc:2] ~ [[luxPerc, luxPerc:2] [luxPerc, luxPerc:2]] ~ [luxPerc, luxPerc:2, cp:5] <[luxPerc, luxPerc:2, cp:5] ~ ~>  [[luxPerc, luxPerc:2] [luxPerc, luxPerc:2]]"]

).s().speed(2)

$: arrange(
  [8, "~"],
  [8, " ~ [luxPerc:4, insect:2] ~ ~ ~ ~ ~ [[luxPerc:4, insect:2] [luxPerc:4, insect]]"]
).s().speed(2).sometimesBy(0.5, x=>x.ply(2))


//kick arrangement, 16 euclidan, 8 jersey
$: arrange(
  [16, "luxKick:1 ~ ~ luxKick:1 ~ ~ ~ ~"],
  [8, "[luxKick:1 ~ ~ ~ luxKick:1 ~ ~ ~ luxKick:1 ~ ~ luxKick:1 ~ ~ luxKick:1 ~]"]
).s()

$: arrange(
  [16, "luxKick:1 ~ ~ luxKick:1 ~ ~ ~ ~"],
  [8, "luxKick:1"]
).s().crush(6).delay(0.05).lpf(2500).every(4, x=>x.chunk(4, x=>x.speed(0.5))).degradeBy(0.2)


//+ coin noise
$: s("~ ~ ~ ~ luxPerc:5 ~ ~ ~, ~ ~ ~ ~ luxPerc:5 ~ ~ ~").room(0.3).speed("<1 1 1 1 1 1 1 0.5>").sometimesBy(0.2, x=>x.ply(2).speed(0.8))

