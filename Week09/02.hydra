a.setBins(4)
a.setSmooth(0.5)
a.setCutoff(2)
a.setScale(10)



// o1 first (so o0 can reference it)
src(o0).modulate(noise(10), 0.04)
  .pixelate(() => a.fft[2]*5, () => a.fft[0]*5+2)
  .mask(
    shape(100, () => Math.abs(a.fft[1])*0.5+0.1, 0.001)
      .add(shape(100, () => Math.abs(a.fft[2])).scrollY(() => a.fft[0]*-02-0.22))
      .add(shape(100, () => Math.abs(a.fft[2])).scrollY(() => a.fft[0]*02+0.22))
      .add(shape(100, () => Math.abs(a.fft[2])).scrollX(() => a.fft[0]*-02-0.22))
      .add(shape(100, () => Math.abs(a.fft[2])).scrollX(() => a.fft[0]*02+0.22))
      .scale(1, 0.5)
  ).out(o1)

// o0 (can now blend with o1)
src(o0).modulate(noise(3),0.005).blend(shape(4,() => a.fft[0]+0.7).scrollY(0.001).scrollX(0.001).modulate(noise(50,0.2)).color(
  [1, 0.96, 0.4, 0],
  [1, 0.85, 0.8, 0.2],
  [1, 0.3, 0.6, 0.6]
).scale(1,0.5),3)
  .layer(
    noise(2, 2)
      .pixelate(() => a.fft[1]*4, () => a.fft[0]*4+2)
      .color(0, 1, 1,1)
      .blend(o1, 2)
      .mask(
        shape(100, () => a.fft[1]*1.2+0.05, 0.1)
          .add(shape(100, () => a.fft[1]*1.3+0.05, 0.1).scrollY(() => a.fft[0]*-0.5-0.1), 0.8)
          .add(shape(100, () => a.fft[1]*1.3+0.05, 0.1).scrollY(() => a.fft[0]*0.5+0.1), 0.8)
          .add(shape(100, () => a.fft[1]*1.3+0.05, 0.1).scrollX(() => a.fft[0]*-0.5-0.1), 0.8)
          .add(shape(100, () => a.fft[1]*1.3+0.05, 0.1).scrollX(() => a.fft[0]*0.5+0.1), 0.8)
          .add(shape(100, () => a.fft[1]*1.2+0.05, 0.8))
          .scale(1, 0.5)
      )
  ).scale([0.3, 0.2, 1, 2, 0.1],1).out(o0)

render(o0)
