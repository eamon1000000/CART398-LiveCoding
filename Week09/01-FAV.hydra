 
solid(0.4,1,4)
  	.diff(shape([100, 10, 8, 6, 1, 10, 8, 6].smooth(10).fast(4),[1,0.8,0.7, 0.6].smooth(10).fast(4)).repeat(50,25)).scale([0.5,1,1.5,2,1,5,1].smooth(10))	
	.out(o2)



noise(1000,10).color(1, 0.01, 0.1).out(o1)

src(o1).mask(
  shape(4, 0.002, 0.001)
    .add(shape(4,0.2,0.001).scrollY(0).scrollX(0),100)//centre again to ensure its there across scaling
    .add(shape(100, 0.2, 0).scrollX(0.1),100)
    .add(shape(100, 0.2, 0).scrollX(-0.1),100)
    // head - gentle bob
    .add(shape(100, 0.18, 0).scrollY(() => 0.1 + Math.sin(time*3)*0.005).scrollX(-0.2), 100)
    // rear upper leg
    .add(shape(4, 0.06, 0).scrollY(-0.12).scrollX(0.1),100)
    // rear lower leg
    .add(shape(4, 0.06, 0)
      .scrollY(() => -0.16 + Math.sin(time*6)*0.01)
      .scrollX(() => 0.095 + Math.cos(time*6)*0.005),100)
    // front upper leg
    .add(shape(4, 0.06, 0).scrollY(-0.12).scrollX(-0.1),100)
    // front lower leg
    .add(shape(4, 0.06, 0)
      .scrollY(() => -0.16 + Math.sin(time*6 + Math.PI)*0.01)
      .scrollX(() => -0.105 + Math.cos(time*6 + Math.PI)*0.005),100)
    // left ear
    .add(shape(3, 0.03, 0).rotate(7)
      .scrollY(() => 0.19 + Math.sin(time*3)*0.005)
      .scrollX(-0.16),100)
    // right ear
    .add(shape(3, 0.03, 0).rotate(5.6)
      .scrollY(() => 0.19 + Math.sin(time*3)*0.005)
      .scrollX(-0.24),100)
    // tail
    .add(shape(100, 0.05, 0)
      .scrollX(() => 0.2 + Math.sin(time*4)*0.005)
      .scrollY(() => 0.07 + Math.cos(time*4)*0.01),100)
    .scale(1, 0.5)
).color(1, 1, 0.01).scale([1.7, 1.65, 1.6, 1.65].smooth(10).fast(10) , 1).scrollY(() => Math.cos(time*10)*0.02).blend(o2).out(o0)

noise(1000,10).blend(o0,0.8).out(o3)
render(o3)
