// @date Jan 31, 2026

samples({
  sample: 'https://cdn.freesound.org/previews/843/843783_15544368-lq.mp3'
})

setCps(140/60/4)

$: s("sample").scrub("{<0.1 0.3> .2@3 0.4!2 <0.9@2 0.3> <0.65 0.48@3> .2@3 0.5 <0.2!2 0.6:1>}/2").delay(0.3).speed(1).gain(0.3).lpf(1000)
$: s("sample").scrub("{<0.1 0.3> .2@3 0.4!2 <0.9@2 0.3> <0.65 0.48@3> .2@3 0.5 <0.2!2 0.6:1>}/2").delay(0.3).speed(0.5).lpf(1000).gain(0.4)

$: s("sample").splice(8,  "0 1 [2 3 0]@2 3 0@2 7").speed(1).gain(0.5).lpf(1000)

$: note("[d#3 [[g3 | c3] g#3]]/4").sound("gm_steel_drums").gain(0.9).degradeBy(0.2).delay(0.2).room(0.4)
$: note("[[d#5 | ~] [[g5| ~] [g#4 | ~]]]/4").sound("gm_steel_drums").gain(0.3).degradeBy(0.2).delay(0.2).room(0.4)
$: note("[d#4 [[g4| ~] [g#4 | ~]]]/4").sound("gm_lead_6_voice").gain(0.6).degradeBy(0.35).delay(0.5).room(0.4)
$: note("<[d#4,d#5,bb]!2 [g#4,g#5] [d,g,ab]>/2").arp("[0 | [0 0]?0.7] [[0 | 1],2] [1 | 2 | 0 0] [0, [2 | 2 2 | 1]]").sometimesBy(0.3, x=>x.arp(rand.range(0,2))).sound("gm_steel_drums").lpf(600).degradeBy(0.2).room(0.5).delay("<0 0 0.5 2 0 0 rand.range(0,2) 0 rand.range(0,2) rand.range(0,2)>").sometimesBy(0.4, x=>x.speed(0.75))

$: s("bd:4").delay(0.25).room(0.3)
$: s("sd:5(<3 1 1 2 5 1 0>,8,<1 1 2>)").delay(0.1).room(0.3).lpf(900)
$: s("sd:<6 8 5 3>(<1 3 1 2 5 1 0>,8,<1 2 3>)").delay(0.2).room(0.3).lpf(1500)
