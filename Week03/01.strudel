samples('github:tidalcycles/dirt-samples')
setCps(115/60/4)

$: note("[g d a d e c <d b#4 d g> <g c4> b# b# a g c d <c4 b#4 g g> <g c4>]".add("<<12 24> <12 17> <0 24>>")).sometimesBy(0.6,x=>x.arp("0 [0,4] 2 [0,2]").lpf(1200).delay(0.5)).orbit(2).s("gm_fx_crystal")
$: note("[e b# g d e c d c]".add("<<-12 0> <0 0> <-12 0>>")).sometimesBy(0.4,x=>x.lpf(800).delay(0.75)).degradeBy(0.3).s("gm_acoustic_bass").gain(0.8)
$: note("[e b# g d e c d c]".add("<<-12 0> <0 12> <-12 0>>")).sometimesBy(0.4,x=>x.lpf(800).delay(0.75)).degradeBy(0.5).s("gm_acoustic_guitar_steel").gain(0.8)
$: note("[e2 b#2 g2 d2 e2 c2 d2 c2]/4").room(0.3)
.s("gm_synth_bass_2").gain(1.1).orbit(2)

$: s("bd:6!4 | bd:4!4 | bd:2(3,8) | bd:3!4").duckorbit(2).bank("rolandtr909")
$: s("bd:3!4 | bd:2!4 | bd(3,8) | bd!4").duckorbit(2).bank("rolandtr909")


$: s("[~ ~ ~ ~ hh:2 ~ hh:2 ~ ~ ~ ~ ~ hh:2 ~ ~ ~ ~ ~ hh:2 hh:2 ~ ~ hh:2 ~ ~ ~ ~ ~ hh:2 ~ ~ ~ ~ ~ hh:2 ~ hh:2 ~ hh:2 ~ ~ ~ ~ ~ hh:2 ~ ~ ~ ~ ~ hh:2 ~ hh:2 ~ hh:2 ~ ~ ~ hh:2 ~ hh:2 ~ ~ ~]/4").bank("rolandtr909").hpf(1200).gain(0.7).pan("0 0.5 1 0.5")
$: s("[~ ~ hh ~ ~ ~ hh ~ ~ ~ ~ ~ hh ~ ~ ~ ~ ~ hh hh ~ ~ hh ~ ~ ~ ~ ~ hh ~ ~ ~ ~ ~ ~ hh hh ~ hh ~ ~ ~ ~ ~ hh ~ ~ ~ ~ hh ~ hh hh ~ hh ~ ~ ~ hh ~ hh ~ ~ ~]/4").gain(1.5).pan("1 0.5 0 0.5")
$: s("sd(5,8,<0 1 2 3>)").degradeBy(0.4)
$: s("[birds | birds:1 | birds:2 | birds:3 | birds:4 | birds:5 | birds:6 | birds:7 | birds:8]").degradeBy(0.2).delay(0.75).room(0.5).lpf(800)

