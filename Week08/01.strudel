//STEREO LOVE REBOOT

setcps(120/60/4)

//Stereo love melodi
$: n("[2@3 7 ~ ~ 7@2 6@2 7@2 8@2 7@2 6@2 7 ~ 5@2 6 ~ 4@2 5 ~ 3@2 4 ~ 2@2 ~ ~ ~ ~ ~!26]/4")
.scale("C4:ionian")//.off(3/8, add(2))//.n("<0 2 0 2 0 2 0 5> | <0 2 0 2 0 2 0 8>")
.layer(
  x=>x.s("gm_blown_bottle").gain(1).sometimesBy(0.15, x=>x.speed(1.5)),
  x=>x.s("gm_blown_bottle").gain(1).adsr("0.01:0.15:0.1:0.2"),
  x=>x.s("gm_acoustic_guitar_steel").gain(1).adsr("0.1:0.1:0.1:0.4").lpf(2500)
).slow(1)

//Stereo Love Suitable Baseline
$: note("[[c2 c2 c2 c2 ~ g2 g2 g2]!3 [b2 b2 b2 b2 ~ ~ [e3 | c2] [e3 | a2]]]/4").layer(
  x=>x.s("gm_kalimba").adsr("0.05:0.1:0.1:0.1").chorus(3).lpf(1200).gain(1),
  x=>x.s("gm_kalimba").adsr("0.01:0.4:0.2:0.4").gain(1).sometimesBy(0.15, x=>x.s("gm_bird_tweet:2, gm_banjo:0")),
  x=>x.s("gm_kalimba").adsr("0.15:0.4:0.2:0.5").gain(1).degradeBy(0.4)
).punchcard()

$: "<[1, 8] [5, [3 | 1]]>*2"
.off(3/8, add(2)).n("<0 2 0 2 0 2 0 5> | <0 2 0 2 0 2 0 8>")
.off(1/4, add(4))
.scale("C:ionian").adsr("0.05:0.2:0.1:0.1").layer(
//x=>x.s("gm_blown_bottle").gain(1).sometimesBy(0.15, x=>x.ply(2).speed(1.5)).degradeBy(0.2),
x=>x.s("gm_blown_bottle").gain(1).adsr("0.01:0.15:0.1:0.2").degradeBy(0.3),
x=>x.s("gm_acoustic_guitar_steel").gain(1).adsr("0.1:0.1:0.1:0.4").lpf(2500).degradeBy(0.5)
)





$: s("luxPerc:5(5,16)").speed("<1 0.8 1.3 0.7 1.1 0.9 0.6>").gain(0.35).room(0.5)
$: s("luxPerc:5(3,16,7)").speed("<0.6 1.2 0.8>").gain(0.15).room(0.6).delay(0.15)


let kickz = "[bd ~ ~ ~ bd ~ ~ ~ bd ~ ~ bd ~ ~ bd ~]".n(6).gain(0.6)
let snarez = "[sd:1 ~ ~ ~ sd:1 ~ ~ ~ sd:1 ~ ~ sd:1 ~ ~ sd:1 ~]"

