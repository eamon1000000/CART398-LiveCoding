  s("bg:2").splice(8,  "4 1 [~ ~ 0]@2 3 1 ~ 2").echo(3, 1 ,0.3).gain(0.05).room(0.4),
  s("9000_bd ~ 9000_bd ~ ~ 9000_bd ~ [9000_bd | ~] ").gain(0.9),
