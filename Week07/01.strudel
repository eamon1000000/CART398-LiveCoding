setCps(122/60/4)
let synthPat = stack(
  note("[e4 ~ e4 ~ ~ ~ e4 ~ e4 ~ ~ ~ e4 ~ ~ ~ e4 ~ e4 ~ ~ ~ e4 ~ <f4 f4 d4 d4> ~ ~ ~ <e4 e4 d4 d4> ~ ~ ~]").s("saw").adsr("0.1:0.1:0.1:0.1").chorus(5).lpf(2500).lpenv(rand.range(0.5,4))

) 

let bassPat = stack(
  note("<[f2*8,f3*8]!4[c3*8, c4!8]!4>").s("gm_synth_bass_2:2").adsr("0.1:0.1:0.1:0.1").chorus(5).lpf(2500).lpenv(rand.range(0.5,4)).gain(1.2),
  note("[e4 ~ e4 ~ ~ ~ e4 ~ e4 ~ ~ ~ e4 ~ ~ ~ e4 ~ e4 ~ ~ ~ e4 ~ <f4 f4 d4 d4> ~ ~ ~ <e4 e4 d4 d4> ~ ~ ~]").s("saw").adsr("0.1:0.1:0.1:0.1").chorus(5).lpf(2500).lpenv(rand.range(0.5,4))

)

let kick = stack(
  note("<[f2*8,f3*8]!4[c3*8, c4!8]!4>").s("gm_synth_bass_2:2").adsr("0.1:0.1:0.1:0.1").chorus(5).lpf(2500).lpenv(rand.range(0.5,4)),
  note("[e4 ~ e4 ~ ~ ~ e4 ~ e4 ~ ~ ~ e4 ~ ~ ~ e4 ~ e4 ~ ~ ~ e4 ~ <f4 f4 d4 d4> ~ ~ ~ <e4 e4 d4 d4> ~ ~ ~]").s("saw").adsr("0.1:0.1:0.1:0.1").chorus(5).lpf(2500).lpenv(rand.range(0.5,4))
)  

let snare = stack(
  note("<[f2*8,f3*8]!4[c3*8, c4!8]!4>").s("gm_synth_bass_2:2").adsr("0.1:0.1:0.1:0.1").chorus(5).lpf(2500).lpenv(rand.range(0.5,4)),
  note("[e4 ~ e4 ~ ~ ~ e4 ~ e4 ~ ~ ~ e4 ~ ~ ~ e4 ~ e4 ~ ~ ~ e4 ~ <f4 f4 d4 d4> ~ ~ ~ <e4 e4 d4 d4> ~ ~ ~]").s("saw").adsr("0.1:0.0.2:0.02:0.1").chorus(5).lpf(2200).lpenv(rand.range(0.5,4)),
  note("[[c2 ~ ~ ~ e4 ~ ~ ~ c2 ~ ~ c2 d3 ~ ~ ~]!2 [f2 ~ ~ ~ g4 ~ ~ ~ f2 ~ ~ f2 ~ ~ <g3 d3> ~]!2]/8").s("gm_overdriven_guitar:2").adsr("0.01:0.4:0.2:0.4").delay(0.2),
  s("sd:3(2,4,1)").lpf(2900).lpenv(4).crush(6).sometimesBy(0.4, x=>x.delay(0.2))
) 

let snare2 = stack(
  note("<[f2*8,f3*8]!4[c3*8, c4!8]!4>").s("gm_synth_bass_2:2").adsr("0.1:0.1:0.1:0.1").chorus(5).lpf(2500).lpenv(rand.range(0.5,4)),
  note("[e4 ~ e4 ~ ~ ~ e4 ~ e4 ~ ~ ~ e4 ~ ~ ~ e4 ~ e4 ~ ~ ~ e4 ~ <f4 f4 d4 d4> ~ ~ ~ <e4 e4 d4 d4> ~ ~ ~]").s("saw").adsr("0.1:0.1:0.1:0.1").chorus(5).lpf(2500).lpenv(rand.range(0.5,4)),
  note("[[c2 e4 ~ c2 e4 ~ d3 ~ c2 d3 ~ c2 d3 ~ e4 ~]!2 [f2 g4 ~ f2 g4 ~ c3 ~ f2 c3 ~ f2 c3 ~ <g3 d3> ~]!2]/8").s("gm_overdriven_guitar:2").adsr("0.01:0.4:0.2:0.4")
)

let snare3 = stack(
  note("<[f2*8,f3*8]!4[c3*8, c4!8]!4>").s("gm_synth_bass_2:2").adsr("0.1:0.1:0.1:0.1").chorus(5).lpf(2500).lpenv(rand.range(0.5,4)),
  note("[[c2 e4 ~ c2 e4 ~ d3 ~ c2 d3 ~ c2 d3 ~ e4 ~]!2 [f2 g4 ~ f2 g4 ~ c3 ~ f2 c3 ~ f2 c3 ~ <g3 d3> ~]!2]/8").s("gm_overdriven_guitar:2").adsr("0.01:0.4:0.2:0.4"),
  chord("<C F>/2").voicing().s("gm_electric_guitar_clean:5").adsr("0.01:0.2:0.2:0.2").echo("<3 2 3 5 7>", 0.125, 0.4),
  note("<c2 f2 g>").s("gm_electric_guitar_clean:2, gm_guitar_fret_noise")

)



$: arrange(
  [8, synthPat],
  [8, bassPat],
  [8,snare],
  [8, snare2],
  [8,snare3]
)

let db = "concertmatemg1"
samples('github:eamon1000000/strudelRepo')
